# ==============================================================================
# JobHunt Pipeline Environment Variables Template
# Copy this file to .env and customize values for local testing / ops.
# DO NOT commit real secrets or credentials to version control.
# ==============================================================================

# AWS Credentials & Configuration
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_DEFAULT_REGION=us-east-1

# DynamoDB & S3 Storage
DYNAMODB_TABLE=Jobsearch
S3_BUCKET_NAME=job-search-pipeline-memory
RESUME_BUCKET=job-search-pipeline-memory
RESUME_KEY=data/resume/resume.txt

# SQS Queue URLs
RAW_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/your-account-id/job-raw-queue
FILTERED_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/your-account-id/job-filtered-queue
RAW_QUEUE_DLQ_URL=https://sqs.us-east-1.amazonaws.com/your-account-id/job-raw-queue-dlq
FILTERED_QUEUE_DLQ_URL=https://sqs.us-east-1.amazonaws.com/your-account-id/job-filtered-queue-dlq

# SNS Notifications
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:your-account-id:jobsearch-approvals

# AWS Bedrock Configuration
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_THROTTLE_RETRIES=2

# Scoring & Guardrail Policy
SCORE_THRESHOLD=80
JOB_EVAL_PROFILE_VERSION=2026-05-13-th80
MAX_JOB_AGE_DAYS=14
HN_MAX_JOB_AGE_DAYS=3
STALE_SCORE_CAP=55
MISSING_DATE_SCORE_CAP=70
LOW_AI_SIGNAL_SCORE_CAP=50
MISSING_SOURCE_SCORE_CAP=40

# Candidate Identity Decoupling (Injected at runtime)
CANDIDATE_NAME="Alex Hunter"
TARGET_ROLE="AI Engineer"
CANDIDATE_LOCATION="open to remote, hybrid, or onsite"
CANDIDATE_LINKEDIN=https://linkedin.com/in/candidate
RETIREIQ_URL=https://huggingface.co/spaces/demo/RetireIQ

# Sender & Safety Gates
# BOTH flags must be "true" to send real emails via SMTP
SENDER_EMAIL=candidate@example.com
SECRETS_NAME=jobserch_gmail
ALLOW_REAL_EMAIL_SEND=false
ALLOW_TELEGRAM_EMAIL_SEND=false

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_token

# External Job Source Credentials (typically stored in AWS Secrets Manager)
JSEARCH_API_KEY=your_jsearch_api_key
GOOGLE_CSE_API_KEY=your_google_cse_key
GOOGLE_CSE_CX=your_google_cse_cx
HUNTER_API_KEY=your_hunter_api_key

# Direct ATS Sources (Greenhouse, Lever, Ashby)
GREENHOUSE_ENABLED=true
GREENHOUSE_BOARDS=[{"slug":"acme","company":"Acme AI"}]
LEVER_ENABLED=true
LEVER_SITES=[{"slug":"acme","company":"Acme AI"}]
ASHBY_ENABLED=true
ASHBY_BOARDS=[{"slug":"acme","company":"Acme AI"}]
ATS_TIMEOUT_SECONDS=15
ATS_MAX_JOBS_PER_BOARD=100

# Test Harness Controls
RUN_LIVE_TESTS=0

